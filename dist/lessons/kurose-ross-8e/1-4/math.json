mrow></mrow></mrow></mrow></msub></mrow></math>", "d_{\\mathrm{end}}(P, N) = (N + P - 1)\\frac{L}{R} + N\\frac{d}{v}": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mrow><msub><mi>d</mi><mrow><mrow><mrow><mrow><mi>e</mi><mi>n</mi><mi>d</mi></mrow></mrow></mrow></mrow></msub><mrow><mo>(</mo><mrow><mi>P</mi><mo>,</mo><mi>N</mi></mrow><mo>)</mo></mrow><mo>=</mo><mrow><mo>(</mo><mrow><mi>N</mi><mo>+</mo><mi>P</mi><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow><mfrac><mrow><mrow><mi>L</mi></mrow></mrow><mrow><mrow><mi>R</mi></mrow></mrow></mfrac><mo>+</mo><mi>N</mi><mfrac><mrow><mrow><mi>d</mi></mrow></mrow><mrow><mrow><mi>v</mi></mrow></mrow></mfrac></mrow></math>", "\\frac{T_{\\mathrm{seg}}}{T_{\\mathrm{single}}} = \\frac{N + P - 1}{N \\cdot P} = \\frac{102}{300} = 0.34": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mrow><mfrac><mrow><mrow><msub><mi>T</mi><mrow><mrow><mrow><mrow><mi>s</mi><mi>e</mi><mi>g</mi></mrow></mrow></mrow></mrow></msub></mrow></mrow><mrow><mrow><msub><mi>T</mi><mrow><mrow><mrow><mrow><mi>s</mi><mi>i</mi><mi>n</mi><mi>g</mi><mi>l</mi><mi>e</mi></mrow></mrow></mrow></mrow></msub></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><mrow><mi>N</mi><mo>+</mo><mi>P</mi><mo>−</mo><mn>1</mn></mrow></mrow><mrow><mrow><mi>N</mi><mo>⋅</mo><mi>P</mi></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><mrow><mn>102</mn></mrow></mrow><mrow><mrow><mn>300</mn></mrow></mrow></mfrac><mo>=</mo><mn>0</mn><mo>.</mo><mn>34</mn></mrow></math>", "R_{\\mathrm{throughput}} = \\min\\{R_1, R_2, \\ldots, R_N\\}": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mrow><msub><mi>R</mi><mrow><mrow><mrow><mrow><mi>t</mi><mi>h</mi><mi>r</mi><mi>o</mi><mi>u</mi><mi>g</mi><mi>h</mi><mi>p</mi><mi>u</mi><mi>t</mi></mrow></mrow></mrow></mrow></msub><mo>=</mo><mrow><mi mathvariant=\"normal\">min</mi><mspace width=\"0.1667em\"/></mrow><mo>{</mo><msub><mi>R</mi><mn>1</mn></msub><mo>,</mo><msub><mi>R</mi><mn>2</mn></msub><mo>,</mo><m