 mathvariant=\"normal\">sin</mi><mspace width=\"0.1667em\"/></mrow><mn>3</mn><mi>t</mi><mo>−</mo><mi>i</mi><mfrac><mrow><mrow><mi>t</mi></mrow></mrow><mrow><mrow><mn>6</mn></mrow></mrow></mfrac><mrow><mi mathvariant=\"normal\">cos</mi><mspace width=\"0.1667em\"/></mrow><mn>3</mn><mi>t</mi></mrow></math>", "x_P(t) = t(\\sin 3t - \\cos 3t), \\quad y_P(t) = t\\cos 3t": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mrow><msub><mi>x</mi><mi>P</mi></msub><mrow><mo>(</mo><mrow><mi>t</mi></mrow><mo>)</mo></mrow><mo>=</mo><mi>t</mi><mrow><mo>(</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi><mspace width=\"0.1667em\"/></mrow><mn>3</mn><mi>t</mi><mo>−</mo><mrow><mi mathvariant=\"normal\">cos</mi><mspace width=\"0.1667em\"/></mrow><mn>3</mn><mi>t</mi></mrow><mo>)</mo></mrow><mo>,</mo><mspace width=\"1em\"/><msub><mi>y</mi><mi>P</mi></msub><mrow><mo>(</mo><mrow><mi>t</mi></mrow><mo>)</mo></mrow><mo>=</mo><mi>t</mi><mrow><mi mathvariant=\"normal\">cos</mi><mspace width=\"0.1667em\"/></mrow><mn>3</mn><mi>t</mi></mrow></math>", "E_1(t) \\equiv (D - 3)x - 6y - f_1(t) = 0, \\quad E_2(t) \\equiv 3x + (D + 3)y - f_2(t) = 0": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mrow><msub><mi>E</mi><mn>1</mn></msub><mrow><mo>(</mo><mrow><mi>t</mi></mrow><mo>)</mo></mrow><mo>≡</mo><mrow><mo>(</mo><mrow><mi>D</mi><mo>−</mo><mn>3</mn></mrow><mo>)</mo></mrow><mi>x</mi><mo>−</mo><mn>6</mn><mi>y</mi><mo>−</mo><msub><mi>f</mi><mn>1</mn></msub><mrow><mo>(</mo><mrow><mi>t</mi></mrow><mo>)</mo></mrow><mo>=</mo><mn>0</mn><mo>,</mo><mspace width=\"1em\"/><msub><mi>E</mi><mn>2</mn></msub><mrow><mo>(</mo><mrow><mi>t</mi></mrow><mo>)</mo></mrow><mo>≡</mo><mn>3</mn><mi>x</mi><mo>+</mo><mrow><mo>(</mo><mrow><mi>D</mi><mo>+</mo><mn>3</mn></mrow><mo>)</mo></mrow><mi>y</mi><mo>−</mo><msub><mi>f</mi><mn>2</mn></msub><mrow><mo>(</mo><mrow><mi>t</mi></mrow><mo>)</mo></mrow><mo>=</mo><mn>0</mn></mrow></math>"}